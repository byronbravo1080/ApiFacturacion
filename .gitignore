# Python y empaquetado
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Cachés de pruebas, linter y cobertura (pytest, Ruff, coverage)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Bases de datos locales de desarrollo y pruebas (SQLite)
*.db
*.sqlite
*.sqlite3

# Variables de entorno y secretos (nunca versionar credenciales - NIST SSDF)
.env
.env.*
!.env.example

# Certificados de firma electrónica del SRI (XAdES-BES) y llaves privadas
*.p12
*.pfx
*.pem
*.key
*.crt

# Entornos Node.js opcionales (herramientas CLI locales)
node_modules/

# Archivos de sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
