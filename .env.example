# Configuración de FacturaEC API
# Para desarrollo local rápido, SQLite no requiere configurar nada adicional:
DATABASE_URL=sqlite:///./facturaec.db

# Para conectar a Supabase o PostgreSQL en Render, descomenta y coloca tu URI:
# DATABASE_URL=postgresql+psycopg://postgres:[TU_CLAVE]@[TU_HOST_SUPABASE]:5432/postgres

# Secreto para firma y verificación de tokens Bearer JWT (mínimo 32 caracteres)
JWT_SECRET=facturaec-clave-secreta-desarrollo-upec-2026-segura

# Duración del token en minutos
JWT_MINUTOS=120

# Simulación de caída del SRI (true para probar contingencia E2, false para funcionamiento normal)
SRI_SIMULAR_CAIDA=false

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
